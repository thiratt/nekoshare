# Copy this file to `.env.local` for development or `.env.production` for production.

# User-facing web app URL used in email links and redirects.
APP_PUBLIC_URL=https://nekoshare.app

# Public API/Auth origin for Better Auth callbacks and cookies.
BETTER_AUTH_URL=https://api.nekoshare.app
BETTER_AUTH_SECRET=replace-with-a-random-32-plus-character-secret

# Additional browser origins allowed to call the API.
# APP_PUBLIC_URL and local dev/Tauri origins are added automatically.
APP_ALLOWED_ORIGINS=https://admin.nekoshare.app,https://share.nekoshare.app

# Infrastructure
# Quote passwords if they contain #, spaces, or other special characters.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=nekoshare
DATABASE_USER=nekoshare
DATABASE_PASSWORD="raw-password"

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD="raw-password"
REDIS_DB=0

NODE_ID=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: enable auth email delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL=
