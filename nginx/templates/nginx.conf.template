worker_processes auto;
pid /run/nginx.pid;

events {
    worker_connections 4096;
    multi_accept on;
}

stream {
    map $ssl_preread_server_name $stream_backend {
        ${NS_SERVER_NAME} tls_native;
        default tls_http;
    }

    upstream tls_http {
        server 127.0.0.1:8443;
    }

    upstream tls_native {
        server 127.0.0.1:8444;
    }

    server {
        listen 443;
        listen [::]:443;
        proxy_pass $stream_backend;
        ssl_preread on;
    }

    server {
        listen 127.0.0.1:8444 ssl;
        ssl_certificate /etc/nginx/tls/${WEB_SERVER_NAME}/origin.crt;
        ssl_certificate_key /etc/nginx/tls/${WEB_SERVER_NAME}/private.key;
        ssl_protocols TLSv1.3;
        proxy_connect_timeout 15s;
        proxy_timeout 3600s;
        proxy_pass server:7781;
    }
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    map $http_cf_connecting_ip $client_ip {
        default $remote_addr;
        "~^[0-9A-Fa-f:\\.]+$" $http_cf_connecting_ip;
    }

    log_format edge_main '$client_ip - $host [$time_local] "$request" $status $body_bytes_sent "$http_referer" "$http_user_agent"';
    access_log /dev/stdout edge_main;
    error_log /dev/stderr warn;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65s;
    server_tokens off;
    client_max_body_size 16m;

    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;
    ssl_protocols TLSv1.3;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    server {
        listen 80 default_server;
        listen [::]:80 default_server;
        server_name _;

        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen 127.0.0.1:8443 ssl;
        http2 on;
        server_name _;

        ssl_certificate /etc/nginx/tls/${WEB_SERVER_NAME}/origin.crt;
        ssl_certificate_key /etc/nginx/tls/${WEB_SERVER_NAME}/private.key;

        return 421;
    }

    server {
        listen 127.0.0.1:8443 ssl;
        http2 on;
        server_name ${API_SERVER_NAME};

        ssl_certificate /etc/nginx/tls/${WEB_SERVER_NAME}/origin.crt;
        ssl_certificate_key /etc/nginx/tls/${WEB_SERVER_NAME}/private.key;

        location / {
            proxy_pass http://server:7780;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header X-Real-IP $client_ip;
            proxy_set_header X-Forwarded-For $client_ip;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port 443;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }
    }

    server {
        listen 127.0.0.1:8443 ssl;
        http2 on;
        server_name ${WEB_SERVER_NAME};

        ssl_certificate /etc/nginx/tls/${WEB_SERVER_NAME}/origin.crt;
        ssl_certificate_key /etc/nginx/tls/${WEB_SERVER_NAME}/private.key;

        location / {
            proxy_pass http://web:8080;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $client_ip;
            proxy_set_header X-Forwarded-For $client_ip;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port 443;
            proxy_read_timeout 60s;
            proxy_send_timeout 60s;
        }
    }

    server {
        listen 127.0.0.1:8443 ssl;
        http2 on;
        server_name ${SHARE_SERVER_NAME};

        ssl_certificate /etc/nginx/tls/${WEB_SERVER_NAME}/origin.crt;
        ssl_certificate_key /etc/nginx/tls/${WEB_SERVER_NAME}/private.key;

        location / {
            proxy_pass http://web:8080;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $client_ip;
            proxy_set_header X-Forwarded-For $client_ip;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port 443;
            proxy_read_timeout 60s;
            proxy_send_timeout 60s;
        }
    }

    include /etc/nginx/conf.d/shortlink.conf;
}
