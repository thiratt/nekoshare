# Copy this file to `docker/.env` before running the production-style stack.
# The web container serves the SPA. The edge nginx container handles TLS,
# hostname routing, API/websocket proxying, and native socket TLS termination.

TZ=UTC

# Infrastructure
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=nekoshare
MYSQL_USER=nekoshare
MYSQL_PASSWORD=change-me
REDIS_USERNAME=
REDIS_PASSWORD="change-me"
REDIS_DB=0

# Public domains
WEB_SERVER_NAME=nekoshare.app
API_SERVER_NAME=api.nekoshare.app
SHARE_SERVER_NAME=share.nekoshare.app
SHORTLINK_SERVER_NAME=nksx.me
SHORTLINK_REDIRECT_HOST=share.nekoshare.app
NS_SERVER_NAME=ns.nekoshare.app

# Server runtime
APP_PUBLIC_URL=https://nekoshare.app
BETTER_AUTH_URL=https://api.nekoshare.app
BETTER_AUTH_SECRET=replace-with-a-random-32-plus-character-secret
APP_ALLOWED_ORIGINS=https://nekoshare.app,https://share.nekoshare.app
NODE_ID=
GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_USER_PROFILE_BUCKET=user-profile
R2_USER_PROFILE_PUBLIC_BASE_URL=
RESEND_API_KEY=re_replace-with-resend-api-key
RESEND_FROM_EMAIL=Nekoshare <noreply@nekoshare.app>

# Frontend build-time values
WEB_API_BASE_URL=https://api.nekoshare.app
WEB_WS_BASE_URL=wss://api.nekoshare.app/ws

# Published ports
HTTP_PORT=80
HTTPS_PORT=443
